<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="#6f85ff"
	android:orientation="vertical"
	android:paddingTop="20dp"
	>
	
	<Toolbar
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:background="#BCBCBC"
		>
		
		<ImageButton
			android:id="@+id/button_drawerToggle"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:background="@android:color/transparent"
			android:contentDescription="123"
			android:padding="20dp"
			android:src="@drawable/menu"
			/>
	</Toolbar>
	
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="20dp"
		>
		
		<ImageView
			android:id="@+id/img_logo"
			android:layout_width="90dp"
			android:layout_height="88dp"
			android:layout_gravity="start"
			android:layout_marginTop="20dp"
			android:src="@drawable/logo_splash"
			android:transitionName="logo_img"
			/>
		
		<TextView
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_marginTop="20dp"
			android:gravity="center"
			android:text="Welcome to Tour Management"
			android:textColor="@color/white"
			android:textSize="25dp"
			/>
	</LinearLayout>
	
	
	<androidx.gridlayout.widget.GridLayout
		android:id="@+id/gridLayout"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="100dp"
		app:columnCount="2"
		app:orientation="horizontal"
		app:rowCount="3"
		>
		
		<androidx.cardview.widget.CardView
			android:id="@+id/cardManageAddTours"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_margin="8dp"
			app:cardCornerRadius="8dp"
			app:cardElevation="4dp"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1"
			>
			
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:background="#E0F7FA"
				android:gravity="center"
				android:orientation="vertical"
				android:padding="16dp"
				>
				
				<ImageView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:src="@drawable/icon_add"
					app:tint="@android:color/holo_purple"
					/>
				
				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="8dp"
					android:text="Add Tour"
					android:textColor="@android:color/black"
					/>
			
			</LinearLayout>
		</androidx.cardview.widget.CardView>
		
		<!-- Repeat CardView blocks for other items (Wallet, Comment/Replies, Reward, Setting) -->
		
		<androidx.cardview.widget.CardView
			android:id="@+id/cardManageToursList"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_margin="8dp"
			app:cardCornerRadius="8dp"
			app:cardElevation="4dp"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1"
			>
			
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:background="#E0F8EC"
				android:gravity="center"
				android:orientation="vertical"
				android:padding="16dp"
				>
				
				<ImageView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:src="@drawable/icon_history"
					app:tint="@android:color/holo_red_dark"
					/>
				
				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="8dp"
					android:text="Tour List"
					android:textColor="@android:color/black"
					/>
			
			</LinearLayout>
		</androidx.cardview.widget.CardView>
		
		<androidx.cardview.widget.CardView
			android:id="@+id/cardManageUsers"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_margin="8dp"
			app:cardCornerRadius="8dp"
			app:cardElevation="4dp"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1"
			>
			
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:background="#F3E5F5"
				android:gravity="center"
				android:orientation="vertical"
				android:padding="16dp"
				>
				
				<ImageView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:src="@drawable/ic_user"
					app:tint="@android:color/holo_blue_bright"
					/>
				
				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="8dp"
					android:text="Management User"
					android:textColor="@android:color/black"
					/>
			
			</LinearLayout>
		</androidx.cardview.widget.CardView>
		
		<androidx.cardview.widget.CardView
			android:id="@+id/cardManageOrder"
			android:layout_width="20dp"
			android:layout_height="wrap_content"
			android:layout_margin="8dp"
			app:cardCornerRadius="8dp"
			app:cardElevation="4dp"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1"
			>
			
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:background="#E3F2FD"
				android:gravity="center"
				android:orientation="vertical"
				android:padding="16dp"
				>
				
				<ImageView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:src="@drawable/icon_report"
					app:tint="@android:color/holo_green_dark"
					/>
				
				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="8dp"
					android:text="Order Management"
					android:textColor="@android:color/black"
					/>
			</LinearLayout>
		</androidx.cardview.widget.CardView>
		
		<androidx.cardview.widget.CardView
			android:id="@+id/logOut"
			android:layout_width="20dp"
			android:layout_height="wrap_content"
			android:layout_margin="8dp"
			app:cardCornerRadius="8dp"
			app:cardElevation="4dp"
			app:layout_columnWeight="1"
			app:layout_rowWeight="1"
			>
			
			<LinearLayout
				android:layout_width="match_parent"
				android:layout_height="match_parent"
				android:background="#E3F2FD"
				android:gravity="center"
				android:orientation="vertical"
				android:padding="16dp"
				>
				
				<ImageView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:src="@drawable/icon_logout"
					app:tint="@android:color/holo_green_dark"
					/>
				
				<TextView
					android:layout_width="wrap_content"
					android:layout_height="wrap_content"
					android:layout_marginTop="8dp"
					android:text="Log Out"
					android:textColor="@android:color/black"
					/>
			</LinearLayout>
		</androidx.cardview.widget.CardView>
	
	
	</androidx.gridlayout.widget.GridLayout>


</LinearLayout>